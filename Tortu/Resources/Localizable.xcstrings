    "activity.locked.point.energy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where the power is coming from, what the battery is really giving up in watts, and how hot the machine says it is."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gücün nereden geldiği, pilin gerçekte kaç watt verdiği ve makinenin kendi ısı derecesi."
          }
        }
      }
    },
    "activity.locked.point.honest": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "And where macOS will not say — another user's processes, which application a packet belonged to — it says so rather than filling the gap in."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS'in söylemediği yerde — başka kullanıcının süreçleri, bir paketin hangi uygulamaya ait olduğu — boşluğu doldurmak yerine söylemediğini yazar."
          }
        }
      }
    },
    "activity.locked.point.memory": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory split into what applications hold, what is wired down and what the compressor is carrying, with swap and the kernel's own pressure level."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belleğin uygulamalar, sabitlenmiş ve sıkıştırılmış olarak dökümü; takas ve çekirdeğin kendi baskı seviyesi."
          }
        }
      }
    },
    "activity.locked.point.processes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every process the machine will admit to, sorted by processor time, memory, threads, wakeups or disk."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Makinenin kabul ettiği her süreç; işlemci, bellek, iş parçacığı, uyandırma ya da diske göre sıralanabilir."
          }
        }
      }
    },
    "activity.locked.point.processor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processor load as it happens, core by core, with the load average and the graphics processor beside it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anlık işlemci yükü, çekirdek çekirdek; yanında yük ortalaması ve grafik işlemcisi."
          }
        }
      }
    },
    "activity.locked.point.traffic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disk and network traffic a second, interface by interface, taken from the drivers' own counters."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saniyedeki disk ve ağ trafiği; arayüz arayüz, sürücülerin kendi sayaçlarından."
          }
        }
      }
    },
    "activity.locked.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tortu's live instrument: the same measure-rather-than-guess approach as the rest of the application, pointed at the machine itself instead of at the disk."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tortu'nun canlı ölçüm ekranı: uygulamanın geri kalanındaki “tahmin etme, ölç” yaklaşımı, bu kez diske değil makinenin kendisine çevrilmiş hâli."
          }
        }
      }
    },
