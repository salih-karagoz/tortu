    "settings.licence.openNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every capability Tortu has is in the build you are running. Nothing is sold, nothing is held back, and there is no licence for the application to check."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tortu'nun sahip olduğu her özellik, çalıştırdığınız yapının içinde. Satılan bir şey yok, saklanan bir şey yok, uygulamanın doğrulayacağı bir lisans da yok."
          }
        }
      }
    },
    "settings.licence.source": {
