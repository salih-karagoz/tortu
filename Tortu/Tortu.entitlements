<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Not sandboxed by design. A sandboxed build cannot reach the cache
         directories Tortu exists to measure, and cannot install a privileged
         helper. This is also why the App Store is not a distribution channel. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
</dict>
</plist>
